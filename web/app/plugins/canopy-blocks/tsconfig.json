{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"allowJs": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"react",
			"react-dom",
			"wordpress__block-editor"
		]
	},
	"include": ["src"]
}
